diff --git a/NOTICE-MetryCAD.md b/NOTICE-MetryCAD.md
new file mode 100644
index 00000000..2d5d8ea4
--- /dev/null
+++ b/NOTICE-MetryCAD.md
@@ -0,0 +1,8 @@
+# MetryCAD
+
+MetryCAD is a derivative of SolidCraft (https://github.com/tangency-labs/solidcraft), whose
+code is available under MIT OR Apache-2.0; those licence notices are kept in this repository.
+
+The SolidCraft name, logo, app icon and the look/theme/ui-kit visual identity covered by
+LICENSE-BRAND are NOT used by MetryCAD: the name, logo, app icon, brand mark and the
+"MetryCAD Azul" / "MetryCAD Grafito" themes are original to this distribution.
diff --git a/apps/solidcraft/build.rs b/apps/solidcraft/build.rs
index afa59689..fbc3b0f1 100644
--- a/apps/solidcraft/build.rs
+++ b/apps/solidcraft/build.rs
@@ -33,6 +33,6 @@ fn version_resource(version: &str) -> String {
     let mut next = || numbers.next().unwrap_or(0);
     let (major, minor, patch) = (next(), next(), next());
     format!(
-        "1 VERSIONINFO\nFILEVERSION {major},{minor},{patch},0\nPRODUCTVERSION {major},{minor},{patch},0\nFILEOS 0x40004\nFILETYPE 0x1\n{{\nBLOCK \"StringFileInfo\"\n{{\nBLOCK \"040904B0\"\n{{\nVALUE \"CompanyName\", \"SolidCraft contributors\"\nVALUE \"FileDescription\", \"SolidCraft, parametric 3D CAD\"\nVALUE \"FileVersion\", \"{version}\"\nVALUE \"InternalName\", \"solidcraft\"\nVALUE \"OriginalFilename\", \"solidcraft.exe\"\nVALUE \"ProductName\", \"SolidCraft\"\nVALUE \"ProductVersion\", \"{version}\"\n}}\n}}\nBLOCK \"VarFileInfo\"\n{{\nVALUE \"Translation\", 0x0409, 1200\n}}\n}}\n"
+        "1 VERSIONINFO\nFILEVERSION {major},{minor},{patch},0\nPRODUCTVERSION {major},{minor},{patch},0\nFILEOS 0x40004\nFILETYPE 0x1\n{{\nBLOCK \"StringFileInfo\"\n{{\nBLOCK \"040904B0\"\n{{\nVALUE \"CompanyName\", \"MetryCAD\"\nVALUE \"FileDescription\", \"MetryCAD, isometric CAD and civil suite\"\nVALUE \"FileVersion\", \"{version}\"\nVALUE \"InternalName\", \"MetryCAD\"\nVALUE \"OriginalFilename\", \"MetryCAD.exe\"\nVALUE \"ProductName\", \"MetryCAD\"\nVALUE \"ProductVersion\", \"{version}\"\n}}\n}}\nBLOCK \"VarFileInfo\"\n{{\nVALUE \"Translation\", 0x0409, 1200\n}}\n}}\n"
     )
 }
